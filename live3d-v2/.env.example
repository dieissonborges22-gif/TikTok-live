# Copie para .env e preencha. NUNCA publique sua chave privada.
PORT=3000

# Ollama acessível pelo computador que executa o servidor
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_CONTEXT=8192

# Cartesia TTS: selecione uma voz masculina na sua conta e copie o Voice ID
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6