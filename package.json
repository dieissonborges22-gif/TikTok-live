{
  "name": "pixel-live-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Host virtual 3D gratuita para TikTok LIVE com respostas automáticas, voz e OBS",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && npm run check:client",
    "check:client": "node --check public/app.js && node --check public/overlay.js"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "tiktok-live-connector": "^2.5.0",
    "three": "^0.180.0"
  }
}
